#usda 1.0
(
    customLayerData = {
        string easy_environment_sha256 = "a0acdc6ac39b6d16f2b04d05e8c513351276a965a0259ebcae36ef5c76682d95"
        string fixture = "Exact acquisition _configure_finger_pads + station.material; no robot drive setup"
        string medium_hard_environment_sha256 = "4ec0ea157404b0e6acb769725839c610e6264226a8ee0b094a0a9e8b6fbfabe5"

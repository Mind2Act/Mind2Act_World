    }
)

def "World"
{
    def "RobotLeft"
    {
        def "Asset"
        {
            def Xform "link7"
            {
                float physxContactReport:threshold = 0

                def Cube "CP09RubberPad" (
                    prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
                )
                {
                    rel material:binding = </World/Materials/CP09FingerRubberLeft>
                    rel material:binding:physics = </World/CP09/GripMaterialLeft>
                    bool physics:collisionEnabled = 1
                    float physxCollision:contactOffset = 0.0001
                    float physxCollision:restOffset = 0
                    double size = 1
                    float3 xformOp:scale = (0.018, 0.003, 0.022)
                    double3 xformOp:translate = (0.0565, -0.0235, -0.0012)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                }
            }

            def Xform "link8"
            {
                float physxContactReport:threshold = 0

                def Cube "CP09RubberPad" (
                    prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
